---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/site';
---
<BaseLayout title="Page not found" noindex>
  <section class="section">
    <div class="container prose">
      <h1>Page not found</h1>
      <p>The page you were looking for doesn't exist or has moved.</p>
      <p class="btn-row">
        <a class="btn btn-primary" href={url('/')}>Go to the home page</a>
        <a class="btn btn-secondary" href={url('/projects/')}>Browse all projects</a>
      </p>
    </div>
  </section>
</BaseLayout>
